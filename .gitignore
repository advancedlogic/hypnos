# process manager state (pids, logs, generated launchers)
.run/

# Rust build output
backend/target/
target/

# Model weights and vendored engine clones are fetched locally, not committed
# (backend/vendor/patches/ is kept: backend/scripts/vendor.sh needs it to rebuild vendor/)
backend/models/
backend/tools/
backend/vendor/*
!backend/vendor/patches/

# Frontend
frontend/node_modules/
frontend/dist/

# Desktop app
desktop/node_modules/
desktop/dist/

# Local config overrides
backend/hypnos.toml
# Runtime model pool overlays (API-11), written next to the config the server runs with
backend/*.models.toml

# machine-specific build config generated by backend/scripts/setup-build-env.*
/.cargo/

# Release archives (backend/scripts/package-release.sh)
/dist/

# Python bytecode from the scripts (bench.py, soak.py)
__pycache__/

# macOS Finder metadata
.DS_Store

# Release archives for `docker build --build-arg SERVER=archive`
/prebuilt/

# Local secrets (HF_TOKEN, API keys)
.env
.env.*
