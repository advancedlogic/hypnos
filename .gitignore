# process manager state (pids, logs, generated launchers)
.run/

# Rust build output
backend/target/
target/

# Model weights and vendored engine clones are fetched locally, not committed
# (backend/vendor/patches/ is kept: backend/scripts/vendor.sh needs it to rebuild vendor/)
backend/models/
backend/tools/
backend/vendor/*
!backend/vendor/patches/

# Frontend
frontend/node_modules/
frontend/dist/

# Desktop app
desktop/node_modules/
desktop/dist/

# Local config overrides
backend/hypnos.toml

# machine-specific build config generated by backend/scripts/setup-build-env.*
/.cargo/

# Release archives (backend/scripts/package-release.sh)
/dist/

# Python bytecode from the scripts (bench.py, soak.py)
__pycache__/
