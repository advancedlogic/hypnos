+    /// The raw `llama_context`, for C APIs this crate does not wrap (Hypnos: libmtmd's audio
+    /// generation helper).
+    ///
+    /// # Safety
+    /// The pointer is valid while `self` lives; the caller must not free it nor use it from
+    /// another thread while `self` is in use.
+    pub unsafe fn as_raw_ptr(&self) -> *mut llama_cpp_sys_2::llama_context {
+        unsafe { self.synchronizable_ptr() }
+    }
