+    let stamp = out.join("hypnos-engine.key");
+    let reuse = engine_key
+        .as_deref()
+        .is_some_and(|key| std::fs::read_to_string(&stamp).is_ok_and(|s| s.trim() == key.trim()));
+    let destination = if reuse {
+        println!("cargo:warning=stable-diffusion.cpp: reusing the cached engine build (HYPNOS_ENGINE_KEY)");
