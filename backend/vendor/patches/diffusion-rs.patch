+fn copy_shared_library(out: &Path) {
+    let Some(profile_dir) = out.ancestors().nth(3).map(Path::to_path_buf) else {
+        return;
+    };
+    let names = ["stable-diffusion.dll", "libstable-diffusion.so", "libstable-diffusion.dylib"];
+    let mut found = Vec::new();
+    for sub in ["bin", "lib", "build", "build/bin"] {
+        for name in names {
+            let candidate = out.join(sub).join(name);
