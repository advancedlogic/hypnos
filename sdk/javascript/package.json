{
  "name": "@hypnos/client",
  "version": "0.4.0",
  "description": "JavaScript/TypeScript client for the Hypnos multi-modal inference server",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advancedlogic/hypnos.git",
    "directory": "sdk/javascript"
  },
  "keywords": ["hypnos", "llm", "inference", "openai", "client"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
